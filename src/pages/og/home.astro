---
/** Link preview for the homepage: a small crate with its taped label, the name and role. */
import OgCard from '../../layouts/OgCard.astro';
import Sleeve from '../../components/Sleeve.astro';
import { site } from '../../data/site';
import { getSections } from '../../lib/records';

const projects = (await getSections())[0].records
  .filter((r) => r.data.format === '12in')
  .slice(0, 3);
---

<OgCard title={`${site.name} · preview`}>
  <div class="crate">
    {projects.map((record, i) => (
      <div class="slot" style={`--i:${i}`}>
        <Sleeve record={record} size={300} />
      </div>
    ))}
    <div class="front">
      <p class="label">
        <span class="tape"></span>
        <span class="box-label">
          {site.boxLabel.line1}
          <br />
          {site.boxLabel.line2}
        </span>
      </p>
    </div>
  </div>
  <div class="text">
    <p class="name d">{site.name}</p>
    <p class="role">{site.role}</p>
    <p class="cue d">Pick a record.</p>
  </div>
</OgCard>

<style>
  .crate {
    position: relative;
    flex: 0 0 520px;
    height: 520px;
  }

  .slot {
    position: absolute;
    left: calc(70px + var(--i) * 26px);
    bottom: calc(150px + var(--i) * 44px);
    z-index: calc(10 - var(--i));
    width: 300px;
    transform: rotate(calc((var(--i) - 1) * 2deg));
  }

  .slot :global(.sleeve) {
    width: 100%;
  }

  /* One-line titles, as in the crate, so each clears the sleeve in front */
  .slot :global(.sleeve .title) {
    font-size: min(11.5cqw, var(--fit-1));
    white-space: nowrap;
  }

  .slot :global(.sleeve--long .head > .cat) {
    display: none;
  }

  .front {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    height: 230px;
    background: var(--kraft);
    box-shadow:
      inset 0 7px 0 var(--kraft-light),
      inset 0 -3px 0 var(--kraft-dark),
      var(--shadow-box);
  }

  .label {
    position: absolute;
    left: 70px;
    top: 70px;
    padding: 18px 24px 16px;
    background: var(--label-paper);
    font-size: 28px;
    line-height: 1.15;
    transform: rotate(-2deg);
    box-shadow: var(--shadow-paper);
  }

  .tape {
    position: absolute;
    left: 110px;
    top: -14px;
    width: 130px;
    height: 30px;
    background: var(--tape);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .name {
    font-size: 104px;
    line-height: 0.86;
    font-weight: 900;
  }

  .role {
    font-size: 32px;
    font-weight: 600;
  }

  .cue {
    margin-top: 8px;
    font-size: 44px;
    line-height: 1;
    color: var(--accent);
  }
</style>
