---
import Base from '../layouts/Base.astro';
import About from '../components/About.astro';
import Crate from '../components/Crate/Crate.astro';
import NowPlaying from '../components/NowPlaying/NowPlaying.astro';
import Ph from '../components/Placeholder.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
import { render } from 'astro:content';
import { isPlaceholder } from '../lib/placeholder-pattern.mjs';
import { shown } from '../lib/visible';
import { assetUrl, getSections, isFull, listId, recordHref } from '../lib/records';

const sections = await getSections();

// schema.org Person (homepage only)
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: new URL(url('/'), Astro.site).href,
  email: `mailto:${site.contact.email}`,
  sameAs: [site.contact.linkedin, site.contact.github],
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.school },
};
// Card records show their short Markdown body in the list (they have no page).
const bodies = new Map(
  await Promise.all(
    sections
      .flatMap((s) => s.records)
      .filter((r) => !isFull(r))
      .map(async (r) => [r.id, (await render(r)).Content] as const),
  ),
);
---

<Base jsonLd={person}>
  <div class="intro">
    <section class="hero" aria-labelledby="hero-name">
      <h1 id="hero-name" class="d">
        {site.name}
      </h1>
      <p class="role">{site.role}</p>
      <p class="availability">{site.availability}</p>
      <div class="cue-row">
        <p class="cue d">Pick a record.</p>
        <svg
          class="cue-arrow"
          aria-hidden="true"
          width="120"
          height="56"
          viewBox="0 0 120 56"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 40 C 30 52, 70 50, 108 22"></path>
          <path d="M94 18 L 110 20 L 104 35"></path>
        </svg>
      </div>
      {/* Shown by crate.ts (keys only work with JS) and used as the crate's description */}
      <p class="hint hint--keys" id="crate-hint" data-crate-hint hidden>
        <kbd aria-hidden="true">←</kbd>
        <kbd aria-hidden="true">→</kbd>
        <span class="visually-hidden">Left and right arrow keys</span>
        <span>to flip through</span>
        <kbd>Enter</kbd>
        <span>to play</span>
      </p>
      <p class="hint hint--swipe" aria-hidden="true">
        Swipe
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </p>
    </section>

    <Crate sections={sections} />
  </div>

  <NowPlaying records={sections.flatMap((s) => s.records)} />

  <section id="all-projects" class="all page" aria-labelledby="all-h">
    <div class="all-head">
      <h2 id="all-h" class="d">
        All records
      </h2>
      <p>The plain list, for when you're in a hurry.</p>
    </div>
    {sections.map((section) => (
      <section class="group" aria-labelledby={`all-${section.id}`}>
        <h3 id={`all-${section.id}`} class="group-h d">
          {section.label} <span class="group-count">{section.records.length}</span>
        </h3>
        <ol>
          {section.records.map((record) => {
            const { catalogue, title, format, tagline, role, team, org, location, dates, links } =
              record.data;
            const Body = bodies.get(record.id);
            const where = team ?? org ?? location;
            return (
              <li id={listId(record)} tabindex="-1" class:list={[!isFull(record) && 'card']}>
                <span class="cat">{format === '7in' ? `${catalogue} · 7″` : catalogue}</span>
                <h4 class="title d">
                  {isFull(record) ? <a href={recordHref(record)}>{title}</a> : <span>{title}</span>}
                </h4>
                {Body ? (
                  <div class="tagline prose">
                    <Body />
                  </div>
                ) : (
                  <p class="tagline">{shown(tagline) && <Ph text={tagline} />}</p>
                )}
                <p class="meta">
                  {shown(role) && <Ph text={role} />}
                  {shown(where) && (
                    <>
                      {' · '}
                      <Ph text={where} />
                    </>
                  )}
                  {shown(dates) && (
                    <>
                      <br />
                      <Ph text={dates} />
                    </>
                  )}
                </p>
                <div class="actions">
                  {isFull(record) && (
                    <a class="tap action" href={recordHref(record)}>
                      Liner notes<span class="visually-hidden">: {title}</span>
                    </a>
                  )}
                  {links?.map((link) =>
                    isPlaceholder(link.href) ? (
                      shown(link.href) && (
                        <span class="action pending">
                          {link.label}: <Ph text={link.href} />
                        </span>
                      )
                    ) : (
                      <a class="tap action" href={assetUrl(link.href)}>
                        {link.label}
                        <span class="visually-hidden">: {title}</span>
                      </a>
                    ),
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </section>

  <About />
</Base>

<style>
  .intro {
    max-width: var(--page-max);
    margin-inline: auto;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 8px var(--gutter);
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(4rem, 9vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .role {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .availability {
    max-width: 400px;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .cue-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 12px;
    color: var(--accent);
  }

  .cue {
    font-size: clamp(2.125rem, 4vw, 2.875rem);
    line-height: 1;
  }

  .cue-arrow {
    display: none;
  }

  .hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }

  .hint--keys {
    display: none;
  }

  kbd {
    padding: 2px 7px;
    border: 1px solid #a89a87;
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--paper-raised);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.8125rem;
  }

  @media (min-width: 900px) {
    .intro {
      padding-inline: var(--gutter);
    }

    .hero {
      padding-inline: 0;
    }

    .hint--swipe {
      display: none;
    }

    .hint--keys:not([hidden]) {
      display: flex;
    }
  }

  /* Hero and crate side by side, as in the desktop mockup */
  @media (min-width: 1200px) {
    .intro {
      display: grid;
      grid-template-columns: minmax(400px, 1fr) minmax(0, 720px);
      align-items: center;
      gap: 40px;
      padding-bottom: 24px;
    }

    h1 {
      font-size: clamp(4rem, 7vw, 6.5rem);
    }

    .cue-arrow {
      display: block;
      flex: 0 0 auto;
    }
  }

  .all {
    padding-block: 72px 32px;
    scroll-margin-top: 0;
  }

  .all-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: 28px;
  }

  .all-head h2 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 900;
  }

  .all-head p {
    color: var(--muted);
  }

  .group + .group {
    margin-top: 56px;
  }

  .group-h {
    margin-bottom: 12px;
    font-size: 1.75rem;
    line-height: 1;
  }

  .group-count {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--muted);
    vertical-align: super;
  }

  ol {
    margin-inline: -12px;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 32px;
    padding: 24px 12px;
    border-top: 1px solid var(--line);
    scroll-margin-block: 96px;
    transition: background-color var(--duration) var(--ease-out);
  }

  /* A card record played from the crate (or reached by its link without JS) */
  li:target,
  li[data-highlight] {
    background: var(--paper-raised);
    box-shadow: inset 4px 0 0 var(--accent);
  }

  .cat {
    flex: 0 0 104px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .title {
    flex: 1 1 200px;
    font-size: 2.125rem;
    line-height: 1;
  }

  .title a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--accent);
  }

  .tagline {
    flex: 2 1 320px;
    line-height: 1.45;
  }

  .prose :global(a) {
    font-weight: 600;
  }

  .meta {
    flex: 1 1 230px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .cat {
      flex-basis: 100%;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 4px;
    flex: 0 0 auto;
  }

  .action {
    padding: 0 12px;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .pending {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    color: var(--muted);
  }
</style>
