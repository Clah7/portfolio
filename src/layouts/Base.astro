---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';

import Contact from '../components/Contact.astro';
import FontFaces from '../components/FontFaces.astro';
import SkipToProjects from '../components/SkipToProjects.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** The full <title>. Defaults to the homepage's: name · role. */
  title?: string;
  description?: string;
  /** Link-preview image, a path under public/ (1200×630, made by `npm run og`). */
  ogImage?: string;
  /** Keep the page out of search results (404, preview templates). */
  noindex?: boolean;
  /** schema.org structured data for this page. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = `${site.name} · ${site.role}`,
  description = site.description,
  ogImage = site.ogImage,
  noindex = false,
  jsonLd,
} = Astro.props;
// Absolute URLs: `site` (origin) + the base-aware path.
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(url(ogImage), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="theme-color" content="#F3EDE2" />
    <meta name="color-scheme" content="light" />
    {/* Lets CSS draw JS-only layouts (the crate's box) from first paint */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <FontFaces />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header page">
      <a class="home d" href={url('/')}>
        {site.shortName}
      </a>
      <nav aria-label="Primary">
        <ul>
          <li>
            <SkipToProjects />
          </li>
          <li>
            <a class="navlink" href={url('/#about')}>
              About
            </a>
          </li>
          <li>
            <a class="navlink" href={url('/#contact')}>
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <Contact />
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding-block: 14px;
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    padding: 0;
    list-style: none;
  }

  .navlink {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 12px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .navlink:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer {
    margin-top: 48px;
    border-top: 2px solid var(--ink);
  }
</style>
