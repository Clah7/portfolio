---
/**
 * The record's stage: what the project shows, driven by `stage.kind`.
 * Used in the Now Playing panel (inside a <template>, so nothing loads until a
 * record is played) and at the top of the liner-notes pages.
 *
 *   video        CSS device frame + muted looping <video> (preload="none");
 *                without a src, a calm "Demo recording coming soon" poster
 *   gallery      scroll-snap slides with Prev/Next and a "2 of 4" counter,
 *                in a device frame (app screens) or a plain frame
 *   diagram      HTML/CSS flow (Diagram.astro)
 *   chart        HTML/CSS bars (Chart.astro)
 *   youtube      click-to-load facade; nothing is requested from YouTube
 *                until it's pressed (stage.ts swaps in youtube-nocookie.com)
 *   certificate  redacted image that opens a <dialog> lightbox
 *   photo        a framed photo with a caption
 *   none         nothing (use hasStage() to skip the column)
 *
 * Behaviour lives in stage.ts (initStage).
 */
import Ph from '../Placeholder.astro';
import Diagram from '../Diagram.astro';
import Chart from './Chart.astro';
import { webpSize } from '../../lib/image-size';
import { isPlaceholder } from '../../lib/placeholder-pattern.mjs';
import { assetUrl, hasStage, type RecordEntry } from '../../lib/records';

interface Props {
  record: RecordEntry;
  /** "panel": Now Playing (its Pause control drives the video). "page": liner notes. */
  context: 'panel' | 'page';
}

const { record, context } = Astro.props;
const { title, stage, cover } = record.data;
const { kind, device, orientation = 'landscape' } = stage;
const colours = `--ground:${cover.ground}; --sleeve-ink:${cover.ink}`;
const frame =
  device === 'tablet' ? `device device--tablet device--${orientation}` : 'device device--phone';
const videoType = (src: string) => (src.endsWith('.webm') ? 'video/webm' : 'video/mp4');
const images = (stage.images ?? []).filter((img) => !isPlaceholder(img.src));
---

{hasStage(record) && (
  <div class:list={['stage', `stage--${kind}`, device && `stage--${device}`]} data-stage>
    {kind === 'video' && (
      <div class="video">
        <div class={frame}>
          <div class="screen" style={colours}>
            {stage.src ? (
              <video
                muted
                playsinline
                loop
                preload="none"
                poster={stage.poster ? assetUrl(stage.poster) : undefined}
                aria-label={stage.alt}
                data-stage-video
              >
                <source src={assetUrl(stage.src)} type={videoType(stage.src)} />
              </video>
            ) : (
              <div class="soon">
                <span class="soon-title d">{title}</span>
                <span class="soon-note">Demo recording coming soon</span>
              </div>
            )}
          </div>
        </div>
        {stage.src && context === 'page' && (
          <button type="button" class="pill" aria-pressed="true" data-stage-video-toggle>
            Pause demo
          </button>
        )}
      </div>
    )}

    {kind === 'gallery' && (
      <div class="gallery" data-gallery>
        <div class={device ? frame : 'plain'}>
          <div
            class="track"
            tabindex="0"
            role="region"
            aria-label={`${stage.alt}, ${images.length} ${images.length === 1 ? 'image' : 'images'}`}
            data-gallery-track
          >
            {images.map((img, i) => (
              <figure class="slide">
                <img
                  src={assetUrl(img.src)}
                  alt={img.alt}
                  {...webpSize(img.src)}
                  loading="lazy"
                  decoding="async"
                />
                {img.caption && (
                  <figcaption class="visually-hidden">
                    {i + 1} of {images.length}: {img.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
        {images[0]?.caption && (
          <p class="gallery-caption" aria-hidden="true" data-gallery-caption>
            {images[0].caption}
          </p>
        )}
        {images.length > 1 && (
          <div class="gallery-controls">
            <button type="button" class="round" data-gallery-prev disabled>
              <span aria-hidden="true">←</span>
              <span class="visually-hidden">Previous image</span>
            </button>
            <p class="counter" aria-live="polite" data-gallery-counter>
              1 of {images.length}
            </p>
            <button type="button" class="round" data-gallery-next>
              <span aria-hidden="true">→</span>
              <span class="visually-hidden">Next image</span>
            </button>
          </div>
        )}
        {images.map((img) => (
          <span hidden data-gallery-caption-text>
            {img.caption ?? ''}
          </span>
        ))}
      </div>
    )}

    {kind === 'diagram' && stage.steps && <Diagram steps={stage.steps} caption={stage.caption} />}

    {kind === 'chart' && stage.chart && <Chart {...stage.chart} />}

    {kind === 'youtube' && stage.youtubeId && (
      <div class="yt" data-yt={stage.youtubeId} data-yt-title={`${title}: video`}>
        <button type="button" class="yt-facade" style={colours} data-yt-play>
          <span class="visually-hidden">Play the video: </span>
          <span class="yt-title d">{title}</span>
          <span class="yt-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="yt-note">Plays from YouTube</span>
        </button>
      </div>
    )}

    {kind === 'certificate' && stage.src && (
      <div class="cert" data-lightbox-root>
        <button type="button" class="cert-open" data-lightbox-open>
          <img
            src={assetUrl(stage.src)}
            alt={stage.alt}
            {...webpSize(stage.src)}
            loading="lazy"
            decoding="async"
          />
          <span class="cert-hint">View full size</span>
        </button>
        <dialog class="lightbox" aria-label={`${title}: certificate`} data-lightbox>
          <img src={assetUrl(stage.src)} alt={stage.alt} {...webpSize(stage.src)} loading="lazy" />
          <button type="button" class="round lightbox-close" data-lightbox-close>
            <span aria-hidden="true">✕</span>
            <span class="visually-hidden">Close</span>
          </button>
        </dialog>
      </div>
    )}

    {kind === 'photo' && stage.src && (
      <figure class="photo">
        <img
          src={assetUrl(stage.src)}
          alt={stage.alt}
          {...webpSize(stage.src)}
          loading="lazy"
          decoding="async"
        />
        {stage.caption && (
          <figcaption>
            <Ph text={stage.caption} />
          </figcaption>
        )}
      </figure>
    )}
  </div>
)}

<script>
  import { initStage } from './stage';

  // Stages already in the page (liner notes). Now Playing initialises its own clones.
  document
    .querySelectorAll<HTMLElement>('[data-stage]')
    .forEach((el) => initStage(el, { autoplay: false }));
</script>

<style>
  .stage {
    min-width: 0;
  }

  /* ---------- Device frames: generic, no status bar, no marks ---------- */

  .video,
  .gallery {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .device {
    position: relative;
    width: 100%;
    padding: 10px;
    background: var(--ink);
    box-shadow:
      inset 0 0 0 2px #3a3531,
      0 30px 40px -24px rgba(40, 25, 10, 0.6);
  }

  .device--phone {
    max-width: 280px;
    aspect-ratio: 9 / 19;
    border-radius: 44px;
  }

  .device--tablet.device--landscape {
    aspect-ratio: 1.43;
    padding: 14px;
    border-radius: 28px;
  }

  .device--tablet.device--portrait {
    max-width: 380px;
    aspect-ratio: 1 / 1.43;
    padding: 14px;
    border-radius: 28px;
  }

  .device .screen,
  .device .track {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 34px;
    background: var(--paper);
  }

  .device--tablet .screen,
  .device--tablet .track {
    border-radius: 16px;
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No demo yet: a calm poster in the record's colours, never a fake screen */
  .soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 100%;
    padding: 24px;
    background: var(--ground);
    color: var(--sleeve-ink);
    text-align: center;
  }

  .soon-title {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .soon-note {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* ---------- Gallery ---------- */

  .plain {
    width: 100%;
    padding: 10px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  /* Positioned, so the visually hidden captions stay clipped by the track */
  .track,
  .slide {
    position: relative;
  }

  .slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
  }

  .slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* App screens are shown whole; any spare space blends into the bezel */
  .device .track {
    background: var(--ink);
  }

  .gallery-caption {
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: center;
  }

  .gallery-controls {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .counter {
    min-width: 5ch;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: center;
    color: var(--muted);
  }

  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    font-size: 1.125rem;
    cursor: pointer;
  }

  .round:disabled {
    border-color: var(--line);
    color: var(--muted);
    cursor: default;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  /* ---------- YouTube facade ---------- */

  .yt {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .yt-facade {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    height: 100%;
    padding: 20px;
    border: 0;
    background: var(--ground);
    color: var(--sleeve-ink);
    font: inherit;
    cursor: pointer;
  }

  .yt-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .yt-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 2px solid currentColor;
    border-radius: 50%;
    padding-left: 4px;
  }

  .yt-note {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .yt :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ---------- Certificate + lightbox ---------- */

  .cert-open {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    width: 100%;
    padding: 10px 10px 14px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--ink);
    font: inherit;
    cursor: zoom-in;
    box-shadow: var(--shadow-paper);
  }

  .cert-open img,
  .photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .cert-hint {
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lightbox {
    width: min(1100px, 94vw);
    max-height: 92vh;
    padding: 12px;
    border: 0;
    background: var(--paper-raised);
  }

  .lightbox::backdrop {
    background: rgba(27, 23, 20, 0.7);
  }

  .lightbox img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(92vh - 24px);
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: 18px;
    right: 18px;
    background: var(--paper);
  }

  /* ---------- Photo ---------- */

  .photo {
    margin: 0;
    padding: 10px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
  }

  .photo figcaption {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
