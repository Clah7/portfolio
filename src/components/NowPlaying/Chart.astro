---
/**
 * A small bar chart drawn in HTML/CSS from `stage.chart`. Every bar has its
 * label and value written out, so it reads without colour (or without CSS).
 * Bars are scaled to the largest value.
 */
import Ph from '../Placeholder.astro';

interface Props {
  title: string;
  metric: string;
  series: { label: string; value: number }[];
  note?: string;
}

const { title, metric, series, note } = Astro.props;
const max = Math.max(...series.map((s) => s.value));
---

<figure class="chart">
  <figcaption class="chart-title">
    <span class="d">{title}</span>
    <span class="metric">{metric}</span>
  </figcaption>
  <ul class="bars">
    {series.map((s, i) => (
      <li class="bar-row">
        <span class="label">{s.label}</span>
        <span class="track" aria-hidden="true">
          <span
            class:list={['bar', i === series.length - 1 && 'bar--last']}
            style={`--w:${((s.value / max) * 100).toFixed(1)}%`}
          />
        </span>
        <span class="value">{s.value}</span>
      </li>
    ))}
  </ul>
  {note && (
    <p class="note">
      <Ph text={note} />
    </p>
  )}
</figure>

<style>
  .chart {
    margin: 0;
    padding: clamp(20px, 3vw, 32px);
    background: var(--paper-raised);
    border: 1px solid var(--line);
  }

  .chart-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    margin-bottom: 20px;
  }

  .chart-title .d {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
  }

  .metric {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bar-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 12px;
    align-items: center;
  }

  .label {
    grid-column: 1 / -1;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .track {
    height: 22px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .bar {
    display: block;
    width: var(--w);
    height: 100%;
    background: var(--muted);
  }

  .bar--last {
    background: var(--ink);
  }

  .value {
    min-width: 3.5em;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 800;
    line-height: 1;
    text-align: right;
  }

  .note {
    margin-top: 18px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
