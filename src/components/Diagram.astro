---
/**
 * A flow diagram drawn in HTML/CSS from a record's frontmatter (`stage.steps`
 * or a `session` entry). The steps are a real ordered list, so the diagram
 * reads as text; the arrows are decoration. Left to right on wide screens,
 * top to bottom on narrow ones. The first and last steps (input and output)
 * are inked.
 *
 *   <Diagram steps={['Business name in', 'Web search', 'MongoDB']} caption="…" />
 */
import Ph from './Placeholder.astro';

interface Props {
  steps: string[];
  caption?: string;
  class?: string;
}

const { steps, caption, class: className } = Astro.props;
---

<figure class:list={['diagram', className]}>
  <ol class="flow">
    {steps.map((step, i) => (
      <li class="step">
        {i > 0 && (
          <span class="arrow" aria-hidden="true">
            <span class="down">↓</span>
            <span class="right">→</span>
          </span>
        )}
        <span class:list={['box', (i === 0 || i === steps.length - 1) && 'box--end']}>
          <Ph text={step} />
        </span>
      </li>
    ))}
  </ol>
  {caption && (
    <figcaption>
      <Ph text={caption} />
    </figcaption>
  )}
</figure>

<style>
  .diagram {
    container-type: inline-size;
    margin: 0;
    padding: clamp(20px, 3vw, 32px);
    background: var(--paper-raised);
    border: 1px solid var(--line);
  }

  .flow {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .arrow {
    padding-left: 16px;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--accent);
  }

  .right {
    display: none;
  }

  .box {
    padding: 10px 14px;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .box--end {
    background: var(--ink);
    color: var(--paper);
  }

  figcaption {
    margin-top: 18px;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* Left to right when the diagram itself has room, whatever the viewport */
  @container (min-width: 560px) {
    .flow,
    .step {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }

    .flow {
      gap: 10px;
    }

    .step {
      gap: 10px;
    }

    .arrow {
      padding-left: 0;
    }

    .down {
      display: none;
    }

    .right {
      display: inline;
    }

    .box {
      max-width: 18ch;
    }
  }
</style>
