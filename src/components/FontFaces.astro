---
/**
 * Self-hosted fonts (Latin subset only, no Google Fonts CDN).
 * The woff2 files come from Fontsource and are hashed into /_astro/ by Vite;
 * the preload and the @font-face use the same import, so they always match.
 */
import bigShoulders from '@fontsource-variable/big-shoulders/files/big-shoulders-latin-wght-normal.woff2?url';
import schibsted from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import permanentMarker from '@fontsource/permanent-marker/files/permanent-marker-latin-400-normal.woff2?url';

// Latin unicode-range, as published by Fontsource for these subsets
const latin =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';

const css = `
@font-face {
  font-family: 'Big Shoulders';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${bigShoulders}') format('woff2-variations'), url('${bigShoulders}') format('woff2');
  unicode-range: ${latin};
}
@font-face {
  font-family: 'Schibsted Grotesk';
  font-style: normal;
  font-display: swap;
  font-weight: 400 900;
  src: url('${schibsted}') format('woff2-variations'), url('${schibsted}') format('woff2');
  unicode-range: ${latin};
}
@font-face {
  font-family: 'Permanent Marker';
  font-style: normal;
  font-display: swap;
  font-weight: 400;
  src: url('${permanentMarker}') format('woff2');
  unicode-range: ${latin};
}`;
---

<link rel="preload" href={bigShoulders} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
