---
/**
 * "Skip to all projects": always visible (not a hide-until-focus skip link),
 * so anyone who'd rather not dig through the crate can jump to the plain list.
 */
import { url } from '../lib/url';
---

<a class="skip" href={url('/#all-projects')}>
  Skip to all projects
</a>

<style>
  .skip {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .skip:hover {
    background: var(--ink);
    color: var(--paper);
  }
</style>
